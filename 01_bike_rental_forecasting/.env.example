# .env.example — copy to .env and adjust if pointing at remote services
# Local dev defaults are pre-filled; no changes needed for a standard setup.

# ── Dagster ───────────────────────────────────────────────────────────────────
DAGSTER_HOME=.dagster

# ── MLflow ────────────────────────────────────────────────────────────────────
# Requires a DB-backed store for the model registry to work (not file://).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# ── LakeFS ────────────────────────────────────────────────────────────────────
# They are not real secrets — they are
# the local dev equivalent of "username: admin, password: admin"
# Replace with real credentials when pointing at a remote or production LakeFS server.
LAKEFS_HOST=http://127.0.0.1:8000
LAKEFS_ACCESS_KEY=AKIAIOSFOLKFSSAMPLES
LAKEFS_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
LAKEFS_REPOSITORY=bike-rental